{
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/register",
      "destination": "/api/index.py"
    },
    {
      "source": "/login",
      "destination": "/api/index.py"
    },
    {
      "source": "/jobs/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/jobs",
      "destination": "/api/index.py"
    },
    {
      "source": "/proposals/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
